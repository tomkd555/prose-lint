{
  "plugins": {
    "html": {
      "extensions": [".htm"]
    }
  },
  "filters": {
    "comments": true
  },
  "rules": {
    "no-start-duplicated-conjunction": true,
    "@textlint-ja/preset-ai-writing": {
      "no-ai-list-formatting": true,
      "no-ai-emphasis-patterns": true,
      "no-ai-colon-continuation": false,
      "no-ai-hype-expressions": false,
      "ai-tech-writing-guideline": false
    }
  }
}
